{
  "name": "rook-and-roll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ROOK & ROLL: pixel-art chess against bots, online, with puzzles and game review",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "sheet": "tsx tools/sheet.ts",
    "relay:dev": "wrangler dev --port 8797",
    "test:online": "tsx tools/online-smoke.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0",
    "ws": "^8.22.0"
  }
}
