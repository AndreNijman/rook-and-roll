{
  "name": "rook-and-roll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ROOK & ROLL: pixel-art chess against bots, online, with puzzles and game review",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
