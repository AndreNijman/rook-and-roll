    "sheet": "tsx tools/sheet.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
